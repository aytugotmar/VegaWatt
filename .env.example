SPRING_PROFILES_ACTIVE=dev

# --- PostgreSQL ---
POSTGRES_DB=vegawatt
POSTGRES_USER=vegawatt
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_REGISTRATION_TOPIC=vegawatt.asset-registration.v1
KAFKA_TELEMETRY_TOPIC=vegawatt.telemetry.v1

# --- Apache Ignite (thin client port) ---
IGNITE_ADDRESSES=localhost:10800

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_CONNECT_TIMEOUT_MS=3000
GEMINI_READ_TIMEOUT_MS=8000

# --- SMTP (Mailpit for local development) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@vegawatt.local

# --- Auth (JWT + bootstrap admin) ---
JWT_SIGNING_SECRET=vegawatt-super-secret-jwt-key-change-in-production-32bytes!
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30
# Set to true once the app is served over HTTPS (any non-local deployment).
COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL=admin@vegawatt.com
BOOTSTRAP_ADMIN_PASSWORD=VegaWatt111!
BOOTSTRAP_ADMIN_FORCE_PASSWORD_RESET=false

# --- Frontend ---
FRONTEND_API_BASE_URL=http://localhost:8080
FRONTEND_DEV_ORIGIN=http://localhost:5173

# --- Scheduling (in seconds) ---
SNAPSHOT_INTERVAL=60
TELEMETRY_INTERVAL=5